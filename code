}


def detect_obstacles(
    frame,
    boundary_ratio
):

    results = yolo.predict(
        frame,
        imgsz=AI_SIZE,
        verbose=False,
        device=DEVICE
    )


    mask = np.zeros(
        (
            PLANNER_HEIGHT,
            PLANNER_WIDTH
        ),
        dtype=np.uint8
    )


    obstacles = []


    boundary_y = int(
        PLANNER_HEIGHT *
        boundary_ratio
    )


    maximum_confidence = 0.0


    for result in results:

        if result.boxes is None:

            continue


        names = result.names


        for box in result.boxes:

            cls_id = int(
                box.cls[0].item()
            )


            confidence = float(
                box.conf[0].item()
            )


            label = names[
                cls_id
            ]


            if label not in TARGET_CLASSES:

                continue


            if confidence < 0.35:

                continue


            x1, y1, x2, y2 = (
                box.xyxy[0]
                .cpu()
                .numpy()
            )


            px1 = int(
                x1 /
                frame_width *
                PLANNER_WIDTH
            )


            py1 = int(
                y1 /
                frame_height *
                PLANNER_HEIGHT
            )


            px2 = int(
                x2 /
                frame_width *
                PLANNER_WIDTH
            )


            py2 = int(
                y2 /
                frame_height *
                PLANNER_HEIGHT
            )


            px1 = max(
                0,
                min(
                    PLANNER_WIDTH - 1,
                    px1
                )
            )


            px2 = max(
                0,
                min(
                    PLANNER_WIDTH - 1,
                    px2
                )
            )


            py1 = max(
                0,
                min(
                    PLANNER_HEIGHT - 1,
                    py1
                )
            )


            py2 = max(
                0,
                min(
                    PLANNER_HEIGHT - 1,
                    py2
                )
            )


            if px2 <= px1:

                continue


            if py2 <= py1:

                continue


            # ------------------------------------------------
            # OWN VEHICLE RULE
            # ------------------------------------------------

            if py2 <= boundary_y:

                cv2.rectangle(
                    mask,
                    (
                        px1,
                        py1
                    ),
                    (
                        px2,
                        py2
                    ),
                    255,
                    -1
                )


                obstacles.append(
                    (
                        px1,
                        py1,
                        px2,
                        py2,
                        label,
                        confidence
                    )
                )


                maximum_confidence = max(
                    maximum_confidence,
                    confidence
                )


            elif py1 < boundary_y < py2:

                clipped_y2 = boundary_y


                if clipped_y2 > py1:

                    cv2.rectangle(
                        mask,
                        (
                            px1,
                            py1
                        ),
                        (
                            px2,
                            clipped_y2
                        ),
                        255,
                        -1
                    )


                    obstacles.append(
                        (
                            px1,
                            py1,
                            px2,
                            clipped_y2,
                            label,
                            confidence
                        )
                    )


                    maximum_confidence = max(
                        maximum_confidence,
                        confidence
                    )


    return (
        mask,
        obstacles,
        maximum_confidence
    )


# ============================================================
# 22. POTHOLE DETECTION
# ============================================================

def detect_potholes(
    frame,
    road_mask,
    obstacle_mask,
    boundary_ratio
):

    gray = cv2.cvtColor(
        frame,
        cv2.COLOR_BGR2GRAY
    )


    gray = cv2.resize(
        gray,
        (
            PLANNER_WIDTH,
            PLANNER_HEIGHT
        )
    )


    allowed = road_mask.copy()


    allowed[
        obstacle_mask > 0
    ] = 0


    boundary_y = int(
        PLANNER_HEIGHT *
        boundary_ratio
    )


    allowed[
        boundary_y:,
        :
    ] = 0


    future_start = int(
        PLANNER_HEIGHT * 0.32
    )


    allowed[
        :future_start,
        :
    ] = 0


    if np.count_nonzero(
        allowed
    ) < 100:

        return (
            np.zeros_like(
                road_mask
            ),
            0.0
        )


    background = cv2.GaussianBlur(
        gray,
        (
            31,
            31
        ),
        0
    )


    normalized = cv2.divide(
        gray,
        background,
        scale=255
    )


    blackhat = cv2.morphologyEx(
        normalized,
        cv2.MORPH_BLACKHAT,
        cv2.getStructuringElement(
            cv2.MORPH_ELLIPSE,
            (
                17,
                17
            )
        )
    )


    _, threshold = cv2.threshold(
        blackhat,
        30,
        255,
        cv2.THRESH_BINARY
    )


    threshold = cv2.bitwise_and(
        threshold,
        allowed
    )


    kernel = np.ones(
        (
            5,
            5
        ),
        np.uint8
    )


    threshold = cv2.morphologyEx(
        threshold,
        cv2.MORPH_OPEN,
        kernel
    )


    threshold = cv2.morphologyEx(
        threshold,
        cv2.MORPH_CLOSE,
        kernel
    )


    contours, _ = cv2.findContours(
        threshold,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )


    pothole_mask = np.zeros_like(
        road_mask
    )


    accepted = 0


    for contour in contours:

        area = cv2.contourArea(
            contour
        )


        if area < 150:

            continue


        if area > 10000:

            continue


        x, y, w, h = cv2.boundingRect(
            contour
        )


        if w <= 0 or h <= 0:

            continue


        aspect = (
            w / float(h)
        )


        if aspect < 0.30:

            continue


        if aspect > 3.50:

            continue


        component = np.zeros_like(
            road_mask
        )


        cv2.drawContours(
            component,
            [contour],
            -1,
            255,
            -1
        )


        component_pixels = (
            np.count_nonzero(
                component
            )
        )


        road_pixels = (
            np.count_nonzero(
                cv2.bitwise_and(
                    component,
                    road_mask
                )
            )
        )


        if component_pixels == 0:

            continue


        road_overlap = (
            road_pixels /
            component_pixels
        )


        if road_overlap < 0.80:

            continue


        if min(w, h) < 8:

            continue


        cv2.drawContours(
            pothole_mask,
            [contour],
            -1,
            255,
            -1
        )


        accepted += 1


    if accepted == 0:

        confidence = 0.0

    elif accepted <= 2:

        confidence = 0.45

    elif accepted <= 4:

        confidence = 0.35

    else:

        confidence = 0.20


    return (
        pothole_mask,
        confidence
    )


# ============================================================
# 23. SAFE SPACE
# ============================================================

def create_safe_space(
    road_mask,
    obstacle_mask,
    pothole_mask,
    boundary_ratio
):

    unsafe = cv2.bitwise_or(
        obstacle_mask,
        pothole_mask
    )


    expanded_unsafe = cv2.dilate(
        unsafe,
        np.ones(
            (
                15,
                15
            ),
            np.uint8
        ),
        iterations=1
    )


    safe = cv2.bitwise_and(
        road_mask,
        cv2.bitwise_not(
            expanded_unsafe
        )
    )


    boundary_y = int(
        PLANNER_HEIGHT *
        boundary_ratio
    )


    safe[
        boundary_y:,
        :
    ] = 0


    return safe


# ============================================================
# 24. ROAD CONFIDENCE
# ============================================================

def calculate_road_confidence(
    road_mask,
    boundary_ratio
):

    start_y = int(
        PLANNER_HEIGHT * 0.32
    )


    end_y = int(
        PLANNER_HEIGHT *
        boundary_ratio
    )


    if end_y <= start_y:

        return 0.0


    region = road_mask[
        start_y:end_y,
        :
    ]


    if region.size == 0:

        return 0.0


    value = np.mean(
        region > 0
    )


    return float(
        max(
            0.0,
            min(
                1.0,
                value
            )
        )
    )


# ============================================================
# 25. BEST GAP
# ============================================================

def find_best_gap(
    safe_mask
):

    best = None


    levels = [
        0.42,
        0.45,
        0.48,
        0.51,
        0.54,
        0.57,
        0.60,
        0.63,
        0.66
    ]


    image_center = (
        PLANNER_WIDTH / 2
    )


    for level in levels:

        y = int(
            PLANNER_HEIGHT *
            level
        )


        if y >= PLANNER_HEIGHT:

            continue


        row = safe_mask[y]


        free = row > 0


        starts = []
        ends = []


        inside = False

        start = 0


        for x in range(
            PLANNER_WIDTH
        ):

            if (
                free[x]
                and
                not inside
            ):

                start = x

                inside = True


            elif (
                not free[x]
                and
                inside
            ):

                starts.append(
                    start
                )

                ends.append(
                    x - 1
                )

                inside = False


        if inside:

            starts.append(
                start
            )

            ends.append(
                PLANNER_WIDTH - 1
            )


        for x1, x2 in zip(
            starts,
            ends
        ):

            width = (
                x2 - x1 + 1
            )


            if width < 20:

                continue


            center = (
                x1 + x2
            ) / 2.0


            width_ratio = (
                width /
                PLANNER_WIDTH
            )


            center_error = abs(
                center -
                image_center
            ) / image_center


            score = (
                width_ratio * 3.0
                -
                center_error * 1.2
                +
                level * 0.30
            )


            candidate = {

                "x1": x1,

                "x2": x2,

                "center": center,

                "width": width,

                "width_ratio":
                    width_ratio,

                "level": level,

                "score": score
            }


            if (
                best is None
                or
                candidate["score"]
                >
                best["score"]
            ):

                best = candidate


    return best


# ============================================================
# 26. PATH SMOOTHING
# ============================================================

def smooth_path(
    center
):

    global previous_path_center


    if previous_path_center is None:

        previous_path_center = center

        return center


    smoothed = (
        previous_path_center *
        (1.0 - PATH_SMOOTHING)
        +
        center *
        PATH_SMOOTHING
    )


    previous_path_center = smoothed


    return smoothed


# ============================================================
# 27. PATH VELOCITY
# ============================================================

def estimate_path_velocity():

    if len(path_history) < 3:

        return 0.0


    values = list(
        path_history
    )


    differences = []


    for i in range(
        1,
        len(values)
    ):

        differences.append(
            values[i]
            -
            values[i - 1]
        )


    recent = differences[
        -5:
    ]


    if not recent:

        return 0.0


    return float(
        np.mean(
            recent
        )
    )


# ============================================================
# 28. PREDICT FUTURE PATH
# ============================================================

def predict_path(
    current_center
):

    global previous_predicted_center


    path_history.append(
        current_center
    )


    velocity = (
        estimate_path_velocity()
    )


    predicted = (
        current_center
        +
        velocity *
        PREDICTION_FRAMES
    )


    maximum_shift = (
        PLANNER_WIDTH *
        MAX_PREDICTION_SHIFT
    )


    minimum = (
        current_center -
        maximum_shift
    )


    maximum = (
        current_center +
        maximum_shift
    )


    predicted = max(
        minimum,
        min(
            maximum,
            predicted
        )
    )


    predicted = max(
        0,
        min(
            PLANNER_WIDTH - 1,
            predicted
        )
    )


    if previous_predicted_center is not None:

        predicted = (
            previous_predicted_center *
            0.60
            +
            predicted *
            0.40
        )


    previous_predicted_center = predicted


    return predicted


# ============================================================
# 29. PATH STABILITY
# ============================================================

def path_stability():

    if len(path_history) < 3:

        return 1.0


    values = np.array(
        list(path_history),
        dtype=np.float32
    )


    changes = np.abs(
        np.diff(values)
    )


    average_change = np.mean(
        changes
    )


    normalized = (
        average_change /
        PLANNER_WIDTH
    )


    stability = (
        1.0 -
        normalized * 5.0
    )


    return float(
        max(
            0.0,
            min(
                1.0,
                stability
            )
        )
    )


# ============================================================
# 30. GAP CONFIDENCE
# ============================================================

def gap_confidence(
    gap
):

    if gap is None:

        return 0.0


    width_ratio = (
        gap["width_ratio"]
    )


    value = (
        width_ratio /
        0.30
    )


    return float(
        max(
            0.0,
            min(
                1.0,
                value
            )
        )
    )


# ============================================================
# 31. FUTURE PATH SAFETY
# ============================================================

def predicted_path_safety(
    safe_mask,
    predicted_center
):

    x = int(
        predicted_center
    )


    x = max(
        0,
        min(
            PLANNER_WIDTH - 1,
            x
        )
    )


    levels = [
        0.45,
        0.50,
        0.55,
        0.60
    ]


    safe_count = 0


    for level in levels:

        y = int(
            PLANNER_HEIGHT *
            level
        )


        if (
            0 <= y <
            PLANNER_HEIGHT
        ):

            left = max(
                0,
                x - 15
            )


            right = min(
                PLANNER_WIDTH,
                x + 15
            )


            region = safe_mask[
                y,
                left:right
            ]


            if (
                region.size > 0
                and
                np.mean(
                    region > 0
                ) > 0.60
            ):

                safe_count += 1


    return (
        safe_count /
        len(levels)
    )


# ============================================================
# 32. SAFETY CONFIDENCE
# ============================================================

def calculate_safety_confidence(
    road_conf,
    gap_conf,
    stability,
    future_safety,
    pothole_conf
):

    confidence = (

        road_conf * 0.25

        +

        gap_conf * 0.30

        +

        stability * 0.20

        +

        future_safety * 0.20

        +

        (1.0 - pothole_conf) * 0.05
    )


    return float(
        max(
            0.0,
            min(
                1.0,
                confidence
            )
        )
    )


# ============================================================
# 33. NAVIGATION DECISION
# ============================================================

def navigation_decision(
    gap,
    predicted_center,
    safety_confidence,
    future_safety
):

    if gap is None:

        return (
            "STOP",
            "STOP"
        )


    width_ratio = (
        gap["width_ratio"]
    )


    if width_ratio < STOP_GAP_RATIO:

        return (
            "STOP",
            "STOP"
        )


    if safety_confidence < STOP_CONFIDENCE:

        return (
            "STOP",
            "STOP"
        )


    if future_safety < 0.25:

        return (
            "STOP",
            "STOP"
        )


    normalized = (
        predicted_center /
        PLANNER_WIDTH
    )


    if (
        width_ratio <
        SLOW_GAP_RATIO

        or

        safety_confidence <
        SLOW_CONFIDENCE

        or

        future_safety <
        0.60
    ):

        safety = "SLOW"

    else:

        safety = "NORMAL"


    if normalized < LEFT_LIMIT:

        direction = "LEFT"

    elif normalized > RIGHT_LIMIT:

        direction = "RIGHT"

    else:

        direction = "FORWARD"


    return (
        direction,
        safety
    )


# ============================================================
# 34. DIRECTION STABILITY
# ============================================================

def stabilize_direction(
    direction
):

    if direction == "STOP":

        direction_history.clear()

        return "STOP"


    direction_history.append(
        direction
    )


    if len(
        direction_history
    ) < 3:

        return direction


    recent = list(
        direction_history
    )[-3:]


    if (
        recent[0]
        ==
        recent[1]
        ==
        recent[2]
    ):

        return recent[-1]


    if (
        "LEFT" in recent
        and
        "RIGHT" in recent
    ):

        return "FORWARD"


    return recent[-1]


# ============================================================
# 35. OVERLAY MASK
# ============================================================

def overlay_mask(
    frame,
    mask,
    color,
    alpha
):

    if mask is None:

        return frame


    full_mask = cv2.resize(
        mask,
        (
            frame_width,
            frame_height
        ),
        interpolation=cv2.INTER_NEAREST
    )


    layer = np.zeros_like(
        frame
    )


    layer[:, :] = color


    selected = (
        full_mask > 0
    )


    frame[selected] = (
        frame[selected] *
        (1.0 - alpha)
        +
        layer[selected] *
        alpha
    ).astype(
        np.uint8
    )


    return frame


