@torch.no_grad()
def get_road_mask(frame):

    small = cv2.resize(
        frame,
        (
            AI_SIZE,
            AI_SIZE
        )
    )


    rgb = cv2.cvtColor(
        small,
        cv2.COLOR_BGR2RGB
    )


    image = Image.fromarray(
        rgb
    )


    inputs = processor(
        images=image,
        return_tensors="pt"
    )


    inputs = {
        k: v.to(DEVICE)
        for k, v in inputs.items()
    }


    # FP16 only for floating tensors.

    if USE_FP16:

        inputs = {
            k: (
                v.half()
                if torch.is_floating_point(v)
                else v
            )
            for k, v in inputs.items()
        }


    outputs = road_model(
        **inputs
    )


    logits = outputs.logits


    logits = torch.nn.functional.interpolate(
        logits,
        size=(
            PLANNER_HEIGHT,
            PLANNER_WIDTH
        ),
        mode="bilinear",
        align_corners=False
    )


    prediction = torch.argmax(
        logits,
        dim=1
    )[0]


    road = (
        prediction.cpu().numpy() == 0
    ).astype(
        np.uint8
    ) * 255


    kernel = np.ones(
        (
            5,
            5
        ),
        np.uint8
    )


    road = cv2.morphologyEx(
        road,
        cv2.MORPH_CLOSE,
        kernel
    )


    return road


# ============================================================
# 19. DYNAMIC OWN-VEHICLE BOUNDARY
# ============================================================

def estimate_vehicle_boundary(
    road_mask
):

    global previous_boundary


    h, w = road_mask.shape


    center_x1 = int(
        w * 0.30
    )


    center_x2 = int(
        w * 0.70
    )


    search_start = int(
        h * MIN_BOUNDARY_RATIO
    )


    search_end = int(
        h * MAX_BOUNDARY_RATIO
    )


    candidate = None


    for y in range(
        search_start,
        search_end
    ):

        center_region = road_mask[
            y,
            center_x1:center_x2
        ]


        road_ratio = np.mean(
            center_region > 0
        )


        if road_ratio < 0.15:

            candidate = (
                y / float(h)
            )

            break


    if candidate is None:

        candidate = (
            previous_boundary
        )


    candidate = max(
        MIN_BOUNDARY_RATIO,
        min(
            MAX_BOUNDARY_RATIO,
            candidate
        )
    )


    smoothed = (
        previous_boundary *
        (1.0 - BOUNDARY_SMOOTHING)
        +
        candidate *
        BOUNDARY_SMOOTHING
    )


    previous_boundary = smoothed


    return smoothed


